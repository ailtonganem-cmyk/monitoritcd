{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "apps/painel/dist/painel/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "painel_api",
        "region": "southamerica-east1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  },
  "emulators": {
    "hub": {
      "host": "127.0.0.1",
      "port": 14400
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 14000
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 18199
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    }
  }
}
