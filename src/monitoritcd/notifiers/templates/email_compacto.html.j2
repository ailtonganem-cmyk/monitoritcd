<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:;">
  <title>{{ subject }}</title>
  <style>
    @media (prefers-color-scheme: dark) {
      .bg-page { background:#1a1a1a !important; }
      .bg-card { background:#2a2a2a !important; }
      .text-primary { color:#f0f0f0 !important; }
      .text-secondary { color:#bbb !important; }
      .link { color:#6db4ff !important; }
    }
  </style>
</head>
{# #111 — Template "compacto": uma linha por item, sem resumo. #}
<body class="bg-page" style="margin:0; padding:0; background:#f5f5f7; font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg-page" style="background:#f5f5f7;">
    <tr>
      <td align="center" style="padding:20px 12px;">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" class="bg-card" style="max-width:640px; width:100%; background:#ffffff; border-radius:8px;">
          <tr>
            <td style="padding:16px 20px; border-bottom:1px solid #ececec;">
              <h1 class="text-primary" style="margin:0; font-size:16px; color:#111;">📊 {{ digest_label }} — {{ items|length }} {% if items|length == 1 %}item{% else %}itens{% endif %}</h1>
              <p class="text-secondary" style="margin:4px 0 0 0; font-size:12px; color:#666;">{{ data_geracao }}</p>
            </td>
          </tr>
          {% for item in items %}
          <tr>
            <td class="text-primary" style="padding:8px 20px; border-bottom:1px solid #f5f5f5; font-size:13px; color:#222;">
              <span style="display:inline-block; width:18px;">{{ item.tier_emoji }}</span>
              <a href="{{ item.url }}" class="link" style="color:#0066cc; text-decoration:none;">{{ item.titulo }}</a>
              <span class="text-secondary" style="color:#999; font-size:11px;">&nbsp;[{{ item.uf }} · {{ item.tipo_label }}]</span>
            </td>
          </tr>
          {% endfor %}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
