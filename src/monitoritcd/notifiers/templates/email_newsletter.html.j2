<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:;">
  <title>{{ subject }}</title>
  <style>
    @media (prefers-color-scheme: dark) {
      .bg-page { background:#1a1a1a !important; }
      .bg-card { background:#2a2a2a !important; }
      .text-primary { color:#f0f0f0 !important; }
      .text-secondary { color:#bbb !important; }
      .text-muted { color:#888 !important; }
      .link { color:#6db4ff !important; }
      .secao-bg { background:#202020 !important; }
    }
  </style>
</head>
{# #114 — Template "newsletter": agrupa por tópico/UF como newsletter editorial. #}
<body class="bg-page" style="margin:0; padding:0; background:#f5f5f7; font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg-page" style="background:#f5f5f7;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" class="bg-card" style="max-width:640px; width:100%; background:#ffffff;">

          {# Cabeçalho de jornal #}
          <tr>
            <td style="padding:32px 28px 16px 28px; border-bottom:3px double #111; text-align:center;">
              <p class="text-muted" style="margin:0 0 4px 0; font-size:11px; color:#999; letter-spacing:2px; text-transform:uppercase;">Edição {{ digest_label }}</p>
              <h1 class="text-primary" style="margin:0; font-size:28px; color:#111; font-family:Georgia,serif;">MonitorITCD</h1>
              <p class="text-secondary" style="margin:4px 0 0 0; font-size:12px; color:#666;">{{ data_geracao }} · {{ items|length }} {% if items|length == 1 %}matéria{% else %}matérias{% endif %}</p>
            </td>
          </tr>

          {% if items|length == 0 %}
          <tr>
            <td class="text-muted" style="padding:40px 28px; text-align:center; color:#888;">Sem matérias relevantes neste período.</td>
          </tr>
          {% else %}

          {# Seções agrupadas por topic_grupo #}
          {% for secao_nome, secao_itens in secoes.items() %}
          <tr>
            <td class="secao-bg" style="padding:16px 28px 8px 28px; background:#f9f9f9;">
              <h2 class="text-primary" style="margin:0; font-size:18px; color:#111; font-family:Georgia,serif; border-bottom:1px solid #ddd; padding-bottom:6px;">{{ secao_nome }} <span class="text-muted" style="font-size:13px; color:#999; font-weight:normal;">({{ secao_itens|length }})</span></h2>
            </td>
          </tr>
          {% for item in secao_itens %}
          <tr>
            <td style="padding:14px 28px;">
              <p class="text-muted" style="margin:0; font-size:11px; color:#999;">{{ item.tier_emoji }} {{ item.uf }} · {{ item.tipo_label }}{% if item.data_pub %} · {{ item.data_pub }}{% endif %}</p>
              <h3 class="text-primary" style="margin:4px 0 6px 0; font-size:14px; color:#111; font-family:Georgia,serif;">
                <a href="{{ item.url }}" class="link" style="color:#111; text-decoration:none; border-bottom:1px solid #999;">{{ item.titulo }}</a>
              </h3>
              <p class="text-secondary" style="margin:0; font-size:13px; line-height:1.6; color:#444;">{{ item.resumo }}</p>
            </td>
          </tr>
          {% endfor %}
          {% endfor %}

          {% endif %}

          <tr>
            <td class="text-muted" style="padding:24px 28px; text-align:center; font-size:11px; color:#999; border-top:1px solid #ececec;">
              {% if bot_url %}<a href="{{ bot_url }}" class="link" style="color:#0066cc; text-decoration:none;">💬 Bot</a>{% endif %}
              {% if dashboard_url %} · <a href="{{ dashboard_url }}" class="link" style="color:#0066cc; text-decoration:none;">📊 Dashboard</a>{% endif %}
              <p style="margin:8px 0 0 0;">MonitorITCD — uso pessoal · {{ data_geracao }}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
