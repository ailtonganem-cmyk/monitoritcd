<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:;">
  <title>{{ subject }}</title>
</head>
<body style="margin:0; padding:0; background:#f5f5f7; font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f7;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px; width:100%; background:#ffffff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,0.05);">

          {# ── Header ─────────────────────────────────── #}
          <tr>
            <td style="padding:24px 24px 8px 24px; border-bottom:1px solid #ececec;">
              <h1 style="margin:0; font-size:18px; color:#111;">📊 MonitorITCD — {{ digest_label }}</h1>
              <p style="margin:6px 0 0 0; font-size:13px; color:#666;">{{ data_geracao }} · {{ items|length }} {% if items|length == 1 %}novidade{% else %}novidades{% endif %}</p>
            </td>
          </tr>

          {# ── Empty state ────────────────────────────── #}
          {% if items|length == 0 %}
          <tr>
            <td style="padding:32px 24px; text-align:center; color:#888;">
              Sem novidades relevantes neste período. Pacífico no front do ITCD.
            </td>
          </tr>
          {% else %}

          {# ── Highlights ─────────────────────────────── #}
          {% if highlights %}
          <tr>
            <td style="padding:16px 24px; background:#fff8e1;">
              <strong style="font-size:14px; color:#7a5c00;">⭐ Destaques</strong>
              <ul style="margin:8px 0 0 0; padding-left:20px; color:#333; font-size:13px;">
                {% for h in highlights %}
                <li style="margin-bottom:4px;">{{ h.titulo }}</li>
                {% endfor %}
              </ul>
            </td>
          </tr>
          {% endif %}

          {# ── Items ──────────────────────────────────── #}
          {% for item in items %}
          <tr>
            <td style="padding:16px 24px; border-bottom:1px solid #f0f0f0;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="vertical-align:top;">
                    <div style="font-size:11px; color:#999; margin-bottom:4px;">
                      <span style="background:{{ item.tier_color }}; color:#fff; padding:2px 6px; border-radius:3px; font-weight:600;">
                        {{ item.tier_emoji }} {{ item.tier_label }}
                      </span>
                      &nbsp;·&nbsp;{{ item.uf }}&nbsp;·&nbsp;{{ item.tipo_label }}
                      {% if item.data_pub %}&nbsp;·&nbsp;{{ item.data_pub }}{% endif %}
                    </div>
                    <h2 style="margin:0 0 6px 0; font-size:15px; line-height:1.4; color:#111;">
                      <a href="{{ item.url }}" style="color:#0066cc; text-decoration:none;">{{ item.titulo }}</a>
                    </h2>
                    <p style="margin:0; font-size:13px; color:#444; line-height:1.5;">{{ item.resumo }}</p>
                    {% if item.fonte_nome %}
                    <p style="margin:6px 0 0 0; font-size:11px; color:#999;">Fonte: {{ item.fonte_nome }}</p>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}

          {% endif %}

          {# ── Footer ─────────────────────────────────── #}
          <tr>
            <td style="padding:16px 24px; text-align:center; font-size:11px; color:#999;">
              Enviado por MonitorITCD · {{ data_geracao }}<br>
              Sistema de uso pessoal — não responder a este e-mail.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
