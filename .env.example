# MonitorITCD — variáveis de ambiente (template)
#
# COPIE este arquivo para `.env` e preencha. NUNCA commite o `.env`.
# Em produção, estas variáveis vêm de GitHub Secrets.
#
# Princípio canônico 3 do CLAUDE.md: secrets PROIBIDOS em código fonte.

# ─────────────────────────────────────────────────────────────────────────────
# Owner (single-user)
# ─────────────────────────────────────────────────────────────────────────────
OWNER_ID=                         # identificador único do dono (qualquer string estável)
OWNER_EMAIL=                      # e-mail do dono — destinatário das notificações

# ─────────────────────────────────────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
GROQ_API_KEY=                     # https://console.groq.com/keys (fallback)

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (Gmail SMTP) — canal OPCIONAL
# Em branco/ausente: a coleta roda, o Telegram notifica e só o e-mail é
# desligado (com aviso no log e na aba Actions).
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_USER=                       # opcional: endereço Gmail de envio
GMAIL_APP_PASSWORD=               # opcional: 16 chars sem espaços — https://myaccount.google.com/apppasswords

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # @BotFather → /newbot
TELEGRAM_OWNER_CHAT_ID=           # /start no bot → bot loga seu chat_id
TELEGRAM_GROUP_CHAT_ID=           # opcional: grupo p/ digest de novidades (id negativo)
TELEGRAM_WEBHOOK_SECRET=          # gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ─────────────────────────────────────────────────────────────────────────────
# Firebase
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=              # ID do projeto Firebase
FIREBASE_STORAGE_BUCKET=          # ex: monitoritcd.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON=    # JSON inteiro do service account em uma única linha (escape \n)

# ─────────────────────────────────────────────────────────────────────────────
# Observabilidade
# ─────────────────────────────────────────────────────────────────────────────
HEALTHCHECKS_URL=                 # https://hc-ping.com/<uuid> (opcional, mas recomendado)

# ─────────────────────────────────────────────────────────────────────────────
# Backup
# ─────────────────────────────────────────────────────────────────────────────
AGE_PUBLIC_KEY=                   # chave pública age para cifrar backups
GDRIVE_FOLDER_ID=                 # pasta Drive onde os backups são depositados

# ─────────────────────────────────────────────────────────────────────────────
# Runtime / debug
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
DRY_RUN=false                     # se true, coleta mas não persiste/notifica
ENV=development                   # development | production
