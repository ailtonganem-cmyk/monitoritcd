# MonitorITCD — variáveis de ambiente (template)
#
# COPIE este arquivo para `.env` e preencha. NUNCA commite o `.env`.
# Em produção, estas variáveis vêm de GitHub Secrets.
#
# Princípio canônico 3 do CLAUDE.md: secrets PROIBIDOS em código fonte.

# ─────────────────────────────────────────────────────────────────────────────
# Owner (single-user)
# ─────────────────────────────────────────────────────────────────────────────
OWNER_ID=                         # identificador único do dono (qualquer string estável)
OWNER_EMAIL=                      # e-mail do dono — destinatário das notificações

# ─────────────────────────────────────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
GROQ_API_KEY=                     # https://console.groq.com/keys (fallback)

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (Gmail SMTP) — canal OPCIONAL
# Em branco/ausente: a coleta roda, o Telegram notifica e só o e-mail é
# desligado (com aviso no log e na aba Actions).
# ─────────────────────────────────────────────────────────────────────────────
GMAIL_USER=                       # opcional: endereço Gmail de envio
GMAIL_APP_PASSWORD=               # opcional: 16 chars sem espaços — https://myaccount.google.com/apppasswords

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # @BotFather → /newbot
TELEGRAM_OWNER_CHAT_ID=           # /start no bot → bot loga seu chat_id
TELEGRAM_GROUP_CHAT_ID=           # opcional: grupo p/ digest de novidades (id negativo)
TELEGRAM_WEBHOOK_SECRET=          # gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ─────────────────────────────────────────────────────────────────────────────
# Painel local (HML = localhost) — Google Sign-In só ailtonganem@gmail.com
# Origem autorizada no cliente OAuth: http://127.0.0.1:8765
# Sem domínio próprio. Sem Functions/Rules.
# Subir: python -m monitoritcd.main painel
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
PAINEL_SESSION_SECRET=
# Chaves extras da cadeia de IA (opcionais; nunca vão para o JSON do painel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=               # extra; não substitui GEMINI/GROQ
DEEPSEEK_API_KEY=                 # extra
OPENCODE_API_KEY=                 # reservado; sem endpoint canônico ainda
# Ollama só em loopback
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ─────────────────────────────────────────────────────────────────────────────
# Firebase — HML = localhost (2026-09-12). NÃO use sefworkstation-hml.
# Prefixo demo- não exige projeto Firebase real. Emuladores cobrem Firestore/Storage.
# Functions de produção (bot_webhook, proxy_br, canary_filter) rodam local via Python/pytest.
# .firebaserc (monitoritcd) é UNKNOWN — não deploy, não apagar, não consultar.
# Contas de teste (automação + admin): Google ailtonganem@gmail.com
# Subir: firebase emulators:start --project demo-monitoritcd --only firestore,storage,auth,ui
# UI do emulador: http://127.0.0.1:14000
# Auth emulator: 127.0.0.1:19099 (não usar 9099 — colide com o Auth do SEF).
# Produção (CI/secrets): omita os hosts de emulador e use o projeto real + SA.
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=demo-monitoritcd
FIREBASE_STORAGE_BUCKET=demo-monitoritcd.appspot.com
# I1-P cutover Minuta SEF (opcional). UID = Auth do dono em minuta-sef.
# MINUTA_SEF_PROJECT_ID=minuta-sef
# MINUTA_SEF_OWNER_UID=
FIREBASE_SERVICE_ACCOUNT_JSON=    # local: vazio (emulador). CI/prod: JSON do SA numa linha
FIRESTORE_EMULATOR_HOST=127.0.0.1:18080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:18199
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099


# ─────────────────────────────────────────────────────────────────────────────
# Observabilidade
# ─────────────────────────────────────────────────────────────────────────────
HEALTHCHECKS_URL=                 # https://hc-ping.com/<uuid> (opcional, mas recomendado)

# ─────────────────────────────────────────────────────────────────────────────
# Backup
# ─────────────────────────────────────────────────────────────────────────────
AGE_PUBLIC_KEY=                   # chave pública age para cifrar backups
GDRIVE_FOLDER_ID=                 # pasta Drive onde os backups são depositados

# ─────────────────────────────────────────────────────────────────────────────
# Runtime / debug
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
DRY_RUN=false                     # se true, coleta mas não persiste/notifica
ENV=development                   # development | production
